{
  "name": "dualwriter",
  "displayName": "DualWriter",
  "description": "Sync files between multiple independent pairs of directories.",
  "version": "2.0.0",
  "packageManager": "pnpm@12.14.0",
  "publisher": "lmezar",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lmezar/dualwriter.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": "^12.14.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dualwriter.syncFiles",
        "title": "Sync Files"
      }
    ],
    "configuration": {
      "title": "DualWriter",
      "properties": {
        "dualwriter.enableAutoSave": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Enable automatic sync when saving files."
        },
        "dualwriter.groups": {
          "type": "array",
          "default": [],
          "scope": "window",
          "description": "Independent directory pairs. Relative paths use the workspace folder, or the saved .code-workspace file's directory in multi-root workspaces. Directories must not overlap, including through symbolic links.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mainDirectory", "secondaryDirectory"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Optional group name shown in sync messages."
              },
              "mainDirectory": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Main directory containing files to sync."
              },
              "secondaryDirectory": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "Destination directory belonging exclusively to this group."
              },
              "bidirectionalSync": {
                "type": "boolean",
                "default": false,
                "description": "Also sync from this group's secondary directory to its main directory."
              }
            }
          }
        }
      }
    },
    "keybindings": [
      {
        "command": "dualwriter.syncFiles",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('Use pnpm to install dependencies.'); process.exit(1); }\"",
    "vscode:prepublish": "pnpm run compile && pnpm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=out/extension.js",
    "watch": "tsc --watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "vsce": {
    "dependencies": false
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "@types/vscode": "1.85.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "fs-extra": "^11.4.1"
  }
}
